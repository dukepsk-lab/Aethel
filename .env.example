# --- Database ---
AETHEL_DATABASE_URL=postgresql+asyncpg://aethel:aethel@localhost:5432/aethel

# --- MT5 connection (gateway mode: Linux brain -> Windows gateway) ---
AETHEL_MT5_MODE=gateway            # "gateway" or "direct" (direct = Windows only)
AETHEL_MT5_GATEWAY_URL=http://mt5-gateway:8001
AETHEL_MT5_GATEWAY_TOKEN=change-me

# --- LLM APIs (cloud only) ---
AETHEL_DEEPSEEK_API_KEY=sk-...      # Ares — DeepSeek (propose)
AETHEL_GEMINI_API_KEY=...           # Athena (gemini-3.1-pro-preview) + Mnemosyne (gemini-3.5-flash)
# Optional overrides (defaults match agent table in README):
# AETHEL_ATHENA_MODEL=gemini-3.1-pro-preview
# AETHEL_MNEMOSYNE_MODEL=gemini-3.5-flash

# --- Execution ---
AETHEL_SHADOW_MODE=true            # log orders without sending (start here!)

# --- Risk ---
AETHEL_MAX_DAILY_LOSS_PCT=3.0
AETHEL_MAX_RISK_PER_TRADE_PCT=1.0
AETHEL_MAX_LOTS_PER_TRADE=1.0
AETHEL_MAX_CONCURRENT_POSITIONS=3
AETHEL_MAX_TRADES_PER_DAY=10
AETHEL_MAX_NET_USD_EXPOSURE_LOTS=2.0

# --- Alerts ---
AETHEL_TELEGRAM_BOT_TOKEN=
AETHEL_TELEGRAM_CHAT_ID=
