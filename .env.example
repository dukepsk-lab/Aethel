# ============================================================
# Aethel — environment configuration
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Database (PostgreSQL + pgvector) ---
# Windows VPS (direct install): use localhost
AETHEL_DATABASE_URL=postgresql+asyncpg://aethel:aethel@localhost:5432/aethel

# --- MT5 connection ---
# Windows VPS: use "direct" — MetaTrader5 package talks to the local terminal
AETHEL_MT5_MODE=direct
# Linux / gateway mode only:
# AETHEL_MT5_MODE=gateway
# AETHEL_MT5_GATEWAY_URL=http://mt5-gateway:8001
# AETHEL_MT5_GATEWAY_TOKEN=change-me

# --- LLM APIs (cloud only) ---
AETHEL_DEEPSEEK_API_KEY=sk-...      # Ares — DeepSeek (propose)
AETHEL_GEMINI_API_KEY=...           # Athena + Mnemosyne + Apollo + Themis
# Optional model overrides (defaults match README agent table):
# AETHEL_ATHENA_MODEL=gemini-3.1-pro-preview
# AETHEL_MNEMOSYNE_MODEL=gemini-3.5-flash
# AETHEL_APOLLO_MODEL=gemini-3.5-flash
# AETHEL_THEMIS_MODEL=gemini-3.1-pro-preview

# --- API server ---
AETHEL_API_HOST=0.0.0.0            # listen on all interfaces (required for VPS access)
AETHEL_API_PORT=8000
# CORS: "*" allows any origin (mobile, browser via VPS IP).
# Restrict to specific origins in production if needed:
# AETHEL_CORS_ORIGINS=["http://1.2.3.4:3000","http://1.2.3.4:8000"]
AETHEL_CORS_ORIGINS=["*"]

# --- Execution ---
AETHEL_SHADOW_MODE=true            # true = paper trade; false = live orders

# --- Risk (hard limits — never overridden by AI) ---
AETHEL_MAX_DAILY_LOSS_PCT=3.0
AETHEL_MAX_RISK_PER_TRADE_PCT=1.0
AETHEL_MAX_LOTS_PER_TRADE=1.0
AETHEL_MAX_CONCURRENT_POSITIONS=3
AETHEL_MAX_TRADES_PER_DAY=10
AETHEL_MAX_NET_USD_EXPOSURE_LOTS=2.0

# --- Alerts ---
AETHEL_TELEGRAM_BOT_TOKEN=
AETHEL_TELEGRAM_CHAT_ID=
